#!/bin/sh

branch=$(git branch --show-current) || {
    printf '%s\n' 'git topic-commit: unable to determine the current branch' >&2
    exit 2
}
if test -z "$branch"; then
    printf '%s\n' 'git topic-commit: refusing to commit from a detached HEAD' >&2
    exit 2
fi

default_branch=$(git config --local --get codex.defaultBranch 2>/dev/null || true)
if test -z "$default_branch"; then
    remote_head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD || true)
    default_branch=${remote_head#origin/}
fi
if test -z "$default_branch"; then
    default_branch=$(
        git ls-remote --symref origin HEAD 2>/dev/null |
            sed -n 's#^ref: refs/heads/\(.*\)[[:space:]]HEAD$#\1#p' |
            sed -n '1p'
    )
fi
if test -z "$default_branch"; then
    printf '%s\n' 'git topic-commit: cannot determine the default branch from codex.defaultBranch, origin/HEAD, or the remote origin HEAD' >&2
    exit 2
fi

if test "$branch" = "$default_branch"; then
    printf 'git topic-commit: refusing to commit on default branch %s; use git commit and approve it\n' "$branch" >&2
    exit 2
fi

branch_before_commit=$(git branch --show-current) || {
    printf '%s\n' 'git topic-commit: unable to verify the current branch before committing' >&2
    exit 2
}
if test "$branch_before_commit" != "$branch"; then
    printf '%s\n' 'git topic-commit: current branch changed before commit; refusing to continue' >&2
    exit 2
fi
if test "$branch_before_commit" = "$default_branch"; then
    printf 'git topic-commit: refusing to commit on default branch %s; use git commit and approve it\n' "$branch_before_commit" >&2
    exit 2
fi

exec git commit "$@"
